[Unit]
Description=nxre — NX Rules Engine companion service
Documentation=https://github.com/twg-security/nx-rules-engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nxre
ExecStart=/opt/nxre/.venv/bin/nxre serve
Restart=on-failure
RestartSec=5

# Where the browser-login bearer token is cached. Kept out of $HOME because
# ProtectHome=true hides it; /opt/nxre stays writable under ProtectSystem=full.
Environment=NXRE_SESSION_FILE=/opt/nxre/session.json

# OPTIONAL — only for unattended startup with no browser to log in through.
# Set a local NX service-account password here (never in the YAML config):
# Environment=NXRE__TWG__PASSWORD=change-me
# A live browser login always takes precedence; this is just the fallback.

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
